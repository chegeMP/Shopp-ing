# Copy to `.env.local` (Next.js) and/or `.env` (Prisma CLI / seed)

# Application
NEXT_PUBLIC_APP_NAME=PriceSnap
NEXT_PUBLIC_APP_URL=http://localhost:3002

# Data source: "memory" (default) or "database" (requires DATABASE_URL + migrate/seed)
DATA_SOURCE=memory
# DATABASE_URL=postgresql://user:pass@localhost:5432/pricesnap

# Cache TTL in seconds (API routes)
CACHE_TTL=300

# Email (Mailgun) — optional; order / subscribe routes return 503 if unset
# MAILGUN_API_KEY=
# MAILGUN_DOMAIN=
# MAILGUN_FROM=PriceSnap <noreply@mg.example.com>

# Paystack (card checkout) — mock mode if unset
# PAYSTACK_SECRET_KEY=

# Platform fee (split from what the customer pays). Shown on checkout, receipts, emails.
# Customer pays only the basket total; fee is deducted internally (not an extra charge).
NEXT_PUBLIC_PLATFORM_FEE_PERCENT=2.5
# NEXT_PUBLIC_PLATFORM_FEE_FIXED_KES=0

# Online payment wall: when "true", card / mobile money runs Paystack + STK before completing.
# Default / unset = no paywall (order completes on submit without charging).
# NEXT_PUBLIC_CHECKOUT_REQUIRE_PAYMENT=true

# Airtel Money (STK) — mock mode if unset
# AIRTEL_CLIENT_ID=
# AIRTEL_CLIENT_SECRET=
# AIRTEL_ENVIRONMENT=sandbox
