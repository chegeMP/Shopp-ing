# Copy to .env.local and fill in values

# Application
NEXT_PUBLIC_APP_NAME=PriceSnap
NEXT_PUBLIC_APP_URL=http://localhost:3002

# Data source: "memory" (default) or "database" (requires DATABASE_URL)
DATA_SOURCE=memory
# DATABASE_URL=postgresql://user:pass@localhost:5432/pricesnap

# Cache TTL in seconds
CACHE_TTL=300
