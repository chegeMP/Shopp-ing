# Copy to `.env.local` (Next.js) and/or `.env` (Prisma CLI / seed)

# Application
NEXT_PUBLIC_APP_NAME=Ma-bei
NEXT_PUBLIC_APP_URL=http://localhost:3002

# Data source: "memory" (default) or "database" (Postgres via Prisma)
DATA_SOURCE=memory
#
# Local Postgres (after `docker compose up -d` in this repo):
# DATABASE_URL=postgresql://mabei:mabei@localhost:5432/mabei-shop
# DIRECT_URL=postgresql://mabei:mabei@localhost:5432/mabei-shop
# DATA_SOURCE=database
#
# Supabase: use the pooled URL for runtime and the direct URL for migrations.
# Find both in Supabase dashboard → Project Settings → Database → Connection string.
# DATABASE_URL=postgresql://postgres.<ref>:<pwd>@<host>:6543/postgres?pgbouncer=true&connection_limit=1
# DIRECT_URL=postgresql://postgres.<ref>:<pwd>@<host>:5432/postgres

# Price scrapers — set to a long random string (e.g. `openssl rand -hex 32`).
# Required by Vercel Cron jobs that hit /api/cron/scrape/<store>.
# CRON_SECRET=
#
# Optional: max products per store per cron invocation (default 15). Lower if you still hit 504 timeouts.
# SCRAPE_CRON_LIMIT=12

# Cache TTL in seconds (API routes)
CACHE_TTL=300

# Email (Mailgun) — optional; order / subscribe routes return 503 if unset
# MAILGUN_API_KEY=
# MAILGUN_DOMAIN=
# MAILGUN_FROM=Ma-bei <noreply@mg.example.com>

# Paystack (card checkout) — mock mode if unset
# PAYSTACK_SECRET_KEY=

# Platform fee (split from what the customer pays). Shown on checkout, receipts, emails.
# Customer pays only the basket total; fee is deducted internally (not an extra charge).
NEXT_PUBLIC_PLATFORM_FEE_PERCENT=2.5
# NEXT_PUBLIC_PLATFORM_FEE_FIXED_KES=0

# Online payment wall: when "true", card / mobile money runs Paystack + STK before completing.
# Default / unset = no paywall (order completes on submit without charging).
# NEXT_PUBLIC_CHECKOUT_REQUIRE_PAYMENT=true

# Airtel Money (STK) — mock mode if unset
# AIRTEL_CLIENT_ID=
# AIRTEL_CLIENT_SECRET=
# AIRTEL_ENVIRONMENT=sandbox
